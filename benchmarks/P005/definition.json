  "default_observation_horizon_s": 0.2,
  "default_oxygen_velocity_m_s": 5,
  "constraints": {
    "detachment_observed": "-1 if event observed, +1 if right-censored"
  },
  "solver": "OpenCFD OpenFOAM v2312 interFoam",
  "monitor": "bundled C++ flowfieldDetachment function object",
  "model_revision": "dual-layer-vof-v1",
