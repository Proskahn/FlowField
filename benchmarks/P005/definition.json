{
  "id": "P005",
  "level": "I",
  "name": "Dual-layer flow channel bubble detachment",
  "dimension": 2,
  "variable_type": "real",
  "coordinates": [
    "normalized_base_height",
    "normalized_degassing_height"
  ],
  "lower_bounds": [
    0,
    0
  ],
  "upper_bounds": [
    1,
    1
  ],
  "decode_mm": [
    "HB=0.5+1.5*x[0]",
    "HD=0.5+3.5*x[1]"
